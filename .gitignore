# --- Secrets (NEVER commit) ---
.env
*.env
secrets/
*-key.json
*-credentials.json
service-account*.json

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Local scraper output (GCS is source of truth) ---
/data/

# --- OS / editor ---
.DS_Store
*.swp
.idea/
.vscode/

# --- Coding ---
/CLAUDE.md
/system_architecture.md

# --- Evaluation artifacts ---
# The judge cache is a cost optimisation, and runs/ is for throwaway dumps.
# evaluation/results/ is deliberately NOT ignored: a stored result is evidence
# for a decision and has to stay readable next to the settings that produced it.
.deepeval_cache/
.deepeval
.deepeval-cache.json
/evaluation/runs/

# setuptools artifacts from a non-editable `pip install .`
build/
dist/

# Local copy of the raw GCS corpus, pulled for offline golden-set harvesting.
.corpus/
